<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="inherit_report_invoice_document" inherit_id="account.report_invoice_document">
    <xpath expr="//t[@t-call='account.document_tax_totals']" position="replace">
      <t t-call="tanatech_account.invoice_document_tax_totals" />
    </xpath>
    <xpath expr="//div[@id='informations']" position="attributes">
      <attribute name="style">font-size: 13px !important;</attribute>
    </xpath>
    <xpath expr="//table[@name='invoice_line_table']" position="attributes">
      <attribute name="style">font-size: 13px !important;</attribute>
    </xpath>
    <xpath expr="//t[@t-set='layout_document_title']" position="attributes">
      <attribute name="style">font-size: 16px !important;</attribute>
    </xpath>
    <xpath expr="//p[@name='payment_communication']" position="after">
      <div class="row" style="margin-top:100px">
        <div class="col-8">
          <span>
            <span style="font-weight: bolder; text-decoration-line: underline; font-size: 13px;">
              Responsable</span>
          </span>
        </div>
        <div class="col-4">
          <span>
            <span style="font-weight: bolder; text-decoration-line: underline; font-size: 13px;">
              Client</span>
          </span>
        </div>
      </div>
    </xpath>
    <xpath expr="//th[@name='th_taxes']" position="attributes">
      <attribute name="t-if">o.journal_id.name != 'Factures clients NA'</attribute>
    </xpath>
    <xpath expr="//td[@name='td_taxes']" position="attributes">
      <attribute name="t-if">o.journal_id.name != 'Factures clients NA'</attribute>
    </xpath>
    <xpath expr="//td[@name='td_price_unit']" position="replace">
      <t t-if="o.journal_id.name != 'Factures clients NA'">
        <td name="td_price_unit"
          t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
          <span class="text-nowrap" t-field="line.price_unit" />
        </td>
      </t>
      <t t-else="">
        <td name="td_price_unit"
          t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
          <span class="text-nowrap" t-field="line.price_unit_ht" />
        </td>
      </t>
    </xpath>
    <xpath expr="//td[@name='td_subtotal']" position="replace">
      <t t-if="o.journal_id.name != 'Factures clients NA'">
        <td name="td_subtotal" class="text-end o_price_total">
          <span class="text-nowrap" t-field="line.price_subtotal" />
        </td>
      </t>
      <t t-else="">
        <td name="td_subtotal" class="text-end o_price_total">
          <span class="text-nowrap" t-field="line.price_total" />
        </td>
      </t>
    </xpath>
    <!-- For factures sans paiement A4 -->
    <xpath expr="//div[@id='partner_vat_address_not_same_as_shipping']" position="after">
      <div class="col-8" style="font-size: 13px">
        <t t-if="o.journal_id.name!='Factures clients NA'">
          <div t-if="o.partner_id.x_studio_nif_1" > NIF: <span
              t-field="o.partner_id.x_studio_nif_1" /></div>
          <div t-if="o.partner_id.x_studio_char_field_d3loF"> STAT: <span
              t-field="o.partner_id.x_studio_char_field_d3loF" /></div>
        </t>
      </div>
    </xpath>
    <xpath expr="//div[@id='partner_vat_address_same_as_shipping']" position="after">
      <div class="col-8" style="font-size: 13px">
        <t t-if="o.journal_id.name!='Factures clients NA'">
          <div t-if="o.partner_id.x_studio_nif_1" > NIF: <span
              t-field="o.partner_id.x_studio_nif_1" /></div>
          <div t-if="o.partner_id.x_studio_char_field_d3loF"> STAT: <span
              t-field="o.partner_id.x_studio_char_field_d3loF" /></div>
        </t>
      </div>
    </xpath>
    <xpath expr="//div[@id='partner_vat_no_shipping']" position="after">
      <div class="col-8" style="font-size: 13px">
        <t t-if="o.journal_id.name!='Factures clients NA'">
          <div t-if="o.partner_id.x_studio_nif_1" > NIF: <span
              t-field="o.partner_id.x_studio_nif_1" /></div>
          <div t-if="o.partner_id.x_studio_char_field_d3loF"> STAT: <span
              t-field="o.partner_id.x_studio_char_field_d3loF" /></div>
        </t>
      </div>
    </xpath>
    <!-- End factures sans paiement A4 -->
  </template>

</odoo>
