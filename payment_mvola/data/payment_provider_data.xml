<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="account_payment_method_mvola" model="account.payment.method">
        <field name="name">Mvola</field>
        <field name="code">mvola</field>
        <field name="payment_type">inbound</field>
    </record>
    <record id="payment_provider_mvola" model="payment.provider">
        <field name="name">Mvola</field>
        <field name="code">mvola</field>
        <field name="image_128" type="base64" file="payment_mvola/static/src/img/mvola.png"/>
        <field name="inline_form_view_id" ref="payment_mvola.mvola_payment_form_number"/>
        <field name="payment_method_ids" eval="[Command.set([ref('payment_mvola.payment_method_mvola')])]"/>
    </record>
</odoo>
