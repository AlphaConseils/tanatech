<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="sanction_category" model="ir.module.category">
            <field name="name">Sanction</field>
            <field name="parent_id" ref="base.module_category_human_resources" />
            <field name="sequence">110</field>
        </record>

        <record id="sanction_group_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="tanatech_sanction.sanction_category" />
        </record>

        <record id="sanction_group_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="tanatech_sanction.sanction_category" />
            <field name="implied_ids" eval="[(4, ref('sanction_group_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />
        </record>

    </data>

    <data noupdate="0">
    
        <record id="sanction_rule_user" model="ir.rule">
            <field name="name">Sanction: user</field>
            <field name="model_id" ref="model_sanction_sanction"/>
            <field name="groups" eval="[(4, ref('sanction_group_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
            <field name="domain_force">[('employee_id.parent_id.user_id.id', '=', user.id)]</field>
        </record>

        <record id="sanction_rule_res_user" model="ir.rule">
            <field name="name">Sanction: user public </field>
            <field name="model_id" ref="model_sanction_sanction"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        </record>   

        <record id="sanction_rule_HR_user" model="ir.rule">
            <field name="name">Sanction hr_group: user</field>
            <field name="model_id" ref="model_sanction_sanction"/>
            <field name="groups" eval="[(4, ref('hr.group_hr_user')), (4, ref('hr.group_hr_manager'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
            <!-- <field name="domain_force">[('approval_request_id.request_owner_id.id', '=', user.id)]</field> -->
            <field name="domain_force">[('sanction_initiator.id', '=', user.id)]</field>
        </record>

        <record id="sanction_rule_manager" model="ir.rule">
            <field name="name">Sanction: manager</field>
            <field name="model_id" ref="model_sanction_sanction"/>
            <field name="groups" eval="[(4, ref('sanction_group_manager'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
    
    </data>
    
</odoo>
