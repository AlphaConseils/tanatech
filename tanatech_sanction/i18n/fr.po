#. module: tanatech_sanction
#: model:mail.template,body_html:tanatech_sanction.lay_off_mail_template
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 14px;\">\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 14px;\">\n"
"                    <div class=\"row\">\n"
"                        <div class=\"col mb-2\">\n"
"                            <p class=\"text-end\">\n"
"                            Antananarivo, le <span t-out=\"datetime.date.today()\" t-options=\"{'widget': 'date', 'format': 'dd MMMM YYYY'}\"></span>\n"
"                            </p>\n"
"                        </div>\n"
"                    </div>\n"
"\n"
"                    <div class=\"row\">\n"
"                        <div class=\"col-12\">\n"
"                            <p>\n"
"                                Nom et prénom : <t t-out=\"object.employee_id.name\"></t><br>\n"
"                                Adresse : <t t-out=\"object.employee_id.private_street\"></t>\n"
"                                            <t t-out=\"object.employee_id.private_street2\"></t>\n"
"                                            <t t-out=\"object.employee_id.private_city\"></t>\n"
"                                            <t t-out=\"object.employee_id.private_city\"></t>\n"
"                                            <t t-out=\"object.employee_id.private_country_id.name\"></t>\n"
"                                            <br>\n"
"                                <t t-if=\"object.employee_id.work_location_id\">\n"
"                                    Agence : <t t-out=\"object.employee_id.work_location_id.name\"></t><br>\n"
"                                </t>\n"
"                                Poste : <t t-out=\"object.employee_id.job_id.name\"></t><br>\n"
"                            </p>\n"
"                        </div>\n"
"                    </div>\n"
"                    <div class=\"row\">\n"
"                        <div class=\"col-7 offset-5\">\n"
"                            <p>\n"
"                                <span style=\"text-decoration: underline;\">Objet </span>: Licenciement\n"
"                            </p>\n"
"                        </div>\n"
"                    </div>\n"
"                    <div class=\"row\">\n"
"                        <div class=\"col-12 mt-2\">\n"
"                            <p><span t-if=\"object.employee_id.gender == 'male'\">Monsieur,</span><span t-if=\"object.employee_id.gender == 'female'\">Madame,</span></p>\n"
"                              <p>Veuillez écrire votre contenu de licenciement ici</p>\n"
"                        </div>\n"
"                    </div>\n"
"                    <div class=\"row\">\n"
"                        <div class=\"col-12\">\n"
"                            <p>Veuillez agréer, <span t-if=\"object.employee_id.gender == 'male'\">Monsieur,</span><span t-if=\"object.employee_id.gender == 'female'\">Madame,</span> nos sincères salutations.</p>\n"
"                        </div>\n"
"                    </div>\n"
"                    <div class=\"row\">\n"
"                        <div class=\"col-12\">\n"
"                            <table width=\"100%\" class=\"no_border\">\n"
"                                <tr t-if=\"object.employee_manager.id != object.hr_responsible.id\">\n"
"                                    <td width=\"40%\"></td>\n"
"                                    <td class=\"text-end\" t-if=\"object.get_signature_manager()\">\n"
"                                        <img t-att-src=\"image_data_uri(object.get_signature_manager())\" t-attf-style=\"width: 200px; height: 90px;\" class=\"float-end\">\n"
"                                    </td>\n"
"                                    <td class=\"text-end pe-2\" t-if=\"object.get_signature_rh_responsible()\">\n"
"                                        <img t-att-src=\"image_data_uri(object.get_signature_rh_responsible())\" t-attf-style=\"width: 200px; height: 90px;\" class=\"float-end\"> \n"
"                                    </td>\n"
"                                </tr>\n"
"                                <tr t-if=\"object.employee_manager.id == object.hr_responsible.id\">\n"
"                                    <td width=\"60%\"></td>\n"
"                                    <td class=\"text-end\" t-if=\"object.get_signature_manager()\">\n"
"                                        <img t-att-src=\"image_data_uri(object.get_signature_manager())\" t-attf-style=\"width: 200px; height: 90px;\" class=\"float-end\">\n"
"                                    </td>\n"
"                                </tr>\n"
"                                <tr width=\"100%\">\n"
"                                    <td colspan=\"3\" class=\"text-center\">\n"
"                                        <img src=\"/tanatech_sanction/static/src/img/cachet_pamf.png\" alt=\"Icône cachet\" t-attf-style=\"width: 200px; height: 200px;\" class=\"float-end\">\n"
"                                    </td>\n"
"                                </tr>\n"
"                            </table>\n"
"                        </div>\n"
"                    </div>\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""

