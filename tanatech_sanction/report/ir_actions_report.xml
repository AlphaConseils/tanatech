<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_warning" model="ir.actions.report">
       <field name="name">Warning Report</field>
       <field name="model">sanction.sanction</field>
       <field name="report_type">qweb-pdf</field>
       <field name="report_name">tanatech_sanction.report_warning</field>
       <field name="report_file">tanatech_sanction.report_warning</field>
       <field name="print_report_name">'Warning - %s' % (object.name)</field>
       <field name="binding_model_id" eval="False"/>
       <field name="binding_type">report</field>
   </record>
