<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="tanatech_sanction_inherit_mail_compose" model="ir.ui.view">
        <field name="name">sanction_wizard.view.form.inherit</field>
        <field name="model">mail.compose.message</field>
        <field name="inherit_id" ref="mail.email_compose_message_wizard_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_send_mail']" position="attributes">
                <attribute name="invisible">context.get('default_sanction_type')</attribute>
            </xpath>
            <xpath expr="//button[@name='action_send_mail']" position="before">
                <button string="Save" name="action_save_mail" type="object" class="oe_highlight" invisible="not context.get('default_sanction_type')"/>
            </xpath>
        </field>
    </record>

</odoo>
