<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sanction_type_wizard" model="ir.ui.view">
        <field name="name">sanction.type.wizard.view.form</field>
        <field name="model">sanction.type.wizard</field>
        <field name="arch" type="xml">
            <form string="Sanction Type">
                <sheet>
                    <group>
                        <group>
                            <field name="sanction_type_id" required="1"/>
                            <field name="is_long_duration" />

                            <field name="sanction_date" invisible="is_long_duration"/>
                            <field name="sanction_start_date" invisible="not is_long_duration"/>
                            <field name="sanction_end_date" invisible="not is_long_duration"/>
                            <field name="sanction_duration" invisible="not is_long_duration"/>
                        </group>
                        <group>
                            <field name="precursor_fact" required="1"/>
                            <field name="demex_date"/>
                        </group>
                    </group>
                    <footer>
                        <button type="object" name="action_save_sanction" string='Save' class="oe_highlight"/>
                        <button special="cancel" string="Cancel" class="ms-1 btn btn-secondary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
