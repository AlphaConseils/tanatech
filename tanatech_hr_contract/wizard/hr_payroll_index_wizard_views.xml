<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_payroll_index_form_view_inherit" model="ir.ui.view">
        <field name="name">hr.payroll.index.form.view</field>
        <field name="model">hr.payroll.index</field>
        <field name="inherit_id" ref="hr_payroll.hr_payroll_index_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='contract_ids']" position="attributes">
                <attribute name="domain">[('contract_category', '=', 'declared')]</attribute>
            </xpath>
        </field>
    </record>

</odoo>
