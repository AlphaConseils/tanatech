<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="quick_create_opportunity_form_inherit" model="ir.ui.view">
        <field name="name">crm.lead.form.quick_create.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.quick_create_opportunity_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="client_code" 
                   string="Code Client"
                   context="{'show_client_code_only': True}"
                   options="{'no_create': True, 'no_open': True}"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="context">{'show_client_code_only': False}</attribute>
            </xpath>
        </field>
    </record>

</odoo>