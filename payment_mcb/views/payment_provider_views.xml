<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Backend configuration view for the MCB provider.
        Odoo 18: uses direct `invisible` attribute instead of `attrs`.
    -->
    <record id="payment_provider_form_mcb" model="ir.ui.view">
        <field name="name">payment.provider.form.mcb</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'mcb'" name="mcb_credentials">
                    <!-- <group> -->
                        <group string="API Credentials">
                            <field name="mcb_merchant_id"
                                   required="code == 'mcb'"/>
                            <field name="mcb_api_password"
                                   password="True"
                                   required="code == 'mcb'"/>
                            <field name="mcb_webhook_secret"
                                   password="True"/>
                        </group>
                        <group string="Options">
                            <field name="mcb_3ds_enabled"/>
                        </group>
                    </group>
                    <!-- Configuration guide: where to find each credential -->
                    <div class="alert alert-info mt-2" role="status" colspan="2" invisible="code != 'mcb'">
                        <h6 class="fw-bold mb-2">
                            <i class="fa fa-info-circle me-1"/>
                            Configuration guide
                        </h6>
                        <p class="mb-1 text-muted small">
                            Where to find your credentials
                        </p>
                        <ol class="mb-2 ps-3 small">
                            <li>Log in to your MCB Payment Gateway dashboard</li>
                            <li>Go to <strong>Admin &gt; Integration</strong></li>
                            <li>
                                <strong>Merchant ID</strong> —
                                shown in the top-right corner of your dashboard
                            </li>
                            <li>
                                <strong>API Password</strong> —
                                generated in <em>Admin &gt; Integration &gt; New API Password</em>
                            </li>
                            <li>
                                <strong>Webhook Secret</strong> —
                                optional — configured in <em>Admin &gt; Notifications</em>
                            </li>
                        </ol>
                        <hr class="my-2"/>
                        <p class="mb-1 small fw-semibold">
                            URLs to configure in your MCB dashboard
                        </p>
                        <p class="mb-1 small">
                            <strong>Webhook URL: </strong>
                            <code>/payment/mcb/webhook</code>
                            (prefixed with your domain)
                        </p>
                        <p class="mb-0 small">
                            <strong>3DS return URL: </strong>
                            <code>/payment/mcb/return</code>
                            (prefixed with your domain)
                        </p>
                    </div>
            <!-- </group> -->
            </group>
        </field>
    </record>
</odoo>
