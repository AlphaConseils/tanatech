#: model:ir.model.fields,field_description:tanatech_hr_holidays.field_hr_leave_type__is_deducted_if_weekend_included
msgid "Is deducted if weekend included"
msgstr "Est déduit si week-end inclus"

#. module: tanatech_hr_holidays
#: model_terms:ir.ui.view,arch_db:tanatech_hr_holidays.hr_leave_view_form_inherit
msgid ""
"<span>Leave ending on Friday gets its duration increased by 3 days.</span>"
msgstr ""
"<span>Les congés se terminant le vendredi voient leur durée augmentée de 3 jours.</span>"

#. module: tanatech_hr_holidays
#: model_terms:ir.ui.view,arch_db:tanatech_hr_holidays.hr_leave_view_form_inherit
msgid ""
"<span>Leave including weekend (saturday and Sunday) gets its duration increased by 2 days.</span>"
msgstr ""
"<span>Les congés incluant le week-end (samedi et dimanche) voient leur durée augmentée de 2 jours.</span>"
