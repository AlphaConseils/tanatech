<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="edit_holiday_status_form_inherit" model="ir.ui.view">
        <field name="name">hr.leave.type.view.form.inherit</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form"/>
        <field name="arch" type="xml">
             <xpath expr="//field[@name='support_document']" position="after">
                <field name="is_deducted_if_weekend_included" />
            </xpath>
        </field>
    </record>

</odoo>
