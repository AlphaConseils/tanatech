<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Generate primary snippet templates that are not predefined -->
    <function model="ir.module.module" name="_generate_primary_snippet_templates">
        <value eval="[ref('base.module_theme_tanatech')]"/>
    </function>

    <record id="website.template_header_default" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>

    <record id="website.default_website" model="website">
        <field name="logo" type="base64" file="theme_tanatech/static/src/img/logo.png"/>
    </record>

</odoo>