<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="tanatech_website.home">
        <section class="home_section py-5">
            <div class="container">

                <div class="owl-carousel owl-theme">
                    <t t-foreach="result.images" t-as="image" t-key="image.id">
                    <t t-log="image"/>

                        <div class="item">
                            <img  t-att-src="'data:image/png;base64,' + image.image" t-att-alt="image.name" class="img-fluid"/>
                        </div>
                    </t>
                </div>
            </div>

        </section>
    </t>
</templates>
