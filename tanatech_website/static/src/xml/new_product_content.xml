<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="tanatech_website.new_products_snippet">
        <section class="new_products_section" id="new_product" data-anchor="true">
            <div class="container-fluid">
                <div class="d-flex justify-content-between align-items-center mb-4 brand-padding">
                    <div>
                        <h2 class="fw-bold">New products</h2>
                        <p class="text-muted">Discover our new solar kits</p>
                    </div>
                    <div>
                        <a href="/shop" class="btn btn-primary">See all</a>
                    </div>
                </div>

                <!-- Grille des produits -->
                <!-- <div class="row g-4"> -->
                <div class="owl-carousel owl-theme new-product-carousel brand-padding">
                    <t t-foreach="result.products" t-as="product" t-key="product.id">
                        <div class="item px-2">
                            <div class="card h-100 border-0 shadow-sm rounded-item overflow-hidden position-relative bg-product p-3">
                                <!-- Badge new -->
                                <span class="badge bg-info position-absolute m-2" style="z-index: 2; left: 5%; top: 5%;">New</span>

                                <!-- Image -->
                                <div class="ratio ratio-1x1" style="z-index: 1;">
                                    <t t-if="product.image_512">
                                        <img t-att-src="'data:image/png;base64,' + product.image_512" class="img-fluid object-fit-cover w-100 h-100 img-product" t-att-alt="product.name" />
                                    </t>
                                    
                                    <t t-else="">
                                        <img src="/web/image/placeholder.png" class="img-fluid object-fit-cover w-100 h-100 img-product" alt="Image par défaut" />
                                    </t>
                                </div>

                                <!-- Infos produit -->
                                <div class="card-body bg-product shadow-none p-0 mt-3">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <h6 class="fw-bold mb-1 w-75 text-truncate " style="display: inline-block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                            <t t-esc="product.name"/>
                                        </h6>
                                        <span class="text-muted text-decoration-line-through " style="font-size: 15px; white-space: nowrap;">3 529 000 Ar</span>
                                    </div>
                                    
                                    <!-- <small class="text-muted d-block mb-2">Variante</small> -->
                                    <div class="mb-2 text-end">
                                        <span class="fw-bold text-dark">3 000 000 Ar</span>
                                    </div>
                                    <div id="add_to_cart_wrap" class="d-flex align-items-center justify-content-between">
                                        <button data-animation-selector=".o_wsale_product_images" type="submit"
                                            class="btn btn-primary btn w-50 js_check_product a-submit d-flex align-items-center justify-content-center p-0 py-2">
                                            <span class="text-nowrap fw-bolder text-white" style="font-size: 10px;">Add to cart</span>
                                        </button>
                                        <div t-attf-class="css_quantity input-group input-group-sm ms-2 align-middle"
                                            contenteditable="false" style="max-width: 120px; height: 30px;">
                                            <a t-attf-href="#"
                                                class="btn btn-link btn-sm js_add_cart_json bg-o-color-2 text-white"
                                                aria-label="Remove one" title="Remove one">
                                                <i class="fa fa-minus" />
                                            </a>
                                            <input type="text"
                                                class="form-control quantity text-center bg-o-color-2 text-white"
                                                data-min="1" name="add_qty" t-att-value="1" style="max-width: 50px;" />
                                            <a t-attf-href="#"
                                                class="btn btn-link btn-sm float_left js_add_cart_json bg-o-color-2 text-white"
                                                aria-label="Add one" title="Add one">
                                                <i class="fa fa-plus" />
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>

            </div>
        </section>
    </t>
</templates>
