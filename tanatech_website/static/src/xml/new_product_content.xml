<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="tanatech_website.new_products_snippet">
        <section class="new_products_section" id="new_product" data-anchor="true">
            <div class="container-fluid">
                <div class="d-flex justify-content-between align-items-center mb-4 brand-padding">
                    <div>
                        <h2 class="fw-bold" t-out="_t('New products')"/>
                        <p class="text-muted" t-out="_t('Discover our new solar kits')"/>
                    </div>
                    <div>
                        <a href="/shop" class="btn btn-primary" t-out="_t('See all')"/>
                    </div>
                </div>

                <div class="owl-carousel owl-theme new-product-carousel brand-padding">
                    <t t-foreach="result.products" t-as="product" t-key="product.id">
                        <div class="item px-2">
                            <div class="card h-100 border-0 shadow-sm rounded-item overflow-hidden position-relative bg-product p-3"
                                t-att-data-product-id="product.id">
                                <!-- Badge new -->
                                <span class="tana-badge tana-badge-new position-absolute" style="z-index: 2; left: 10px; top: 10px;" t-out="_t('New')"/>

                                <!-- Image -->
                                <div class="ratio ratio-1x1" style="z-index: 1;">
                                    <t t-if="product.image_512">
                                        <img t-att-src="'data:image/png;base64,' + product.image_512" class="img-fluid object-fit-cover w-100 h-100 img-product" t-att-alt="product.name" />
                                    </t>
                                    <t t-else="">
                                        <img src="/web/image/placeholder.png" class="img-fluid object-fit-cover w-100 h-100 img-product" t-att-alt="_t('Default image')" />
                                    </t>
                                </div>

                                <!-- Infos produit -->
                                <div class="card-body bg-product shadow-none p-0 mt-3">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <h6 class="fw-bold mb-1 w-75 text-truncate" style="display: inline-block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                            <t t-esc="product.name"/>
                                        </h6>
                                    </div>

                                    <div class="mb-2 text-end">
                                        <span class="fw-bold text-dark">
                                            <t t-if="result.currency_position === 'before'">
                                                <t t-esc="result.currency_symbol"/>&#160;<t t-esc="product.list_price.toLocaleString('fr-FR')"/>
                                            </t>
                                            <t t-else="">
                                                <t t-esc="product.list_price.toLocaleString('fr-FR')"/> <t t-esc="result.currency_symbol"/>
                                            </t>
                                        </span>
                                    </div>

                                    <div class="d-flex align-items-stretch gap-2">
                                        <button type="button"
                                            class="btn btn-primary rounded-3 flex-grow-1 tana-add-to-cart d-flex align-items-center justify-content-center">
                                            <span class="text-nowrap fw-bold text-white" t-out="_t('Add to cart')"/>
                                        </button>
                                        <div class="tana-qty-group d-flex align-items-stretch rounded-3 overflow-hidden" contenteditable="false">
                                            <a href="#" class="tana-qty-minus text-white"
                                                t-att-aria-label="_t('Remove one')" t-att-title="_t('Remove one')">
                                                <i class="fa fa-minus"/>
                                            </a>
                                            <input type="text"
                                                class="tana-qty text-center text-white border-0 bg-transparent fw-bold"
                                                data-min="1" value="1"/>
                                            <a href="#" class="tana-qty-plus text-white"
                                                t-att-aria-label="_t('Add one')" t-att-title="_t('Add one')">
                                                <i class="fa fa-plus"/>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>

            </div>
        </section>
    </t>
</templates>
