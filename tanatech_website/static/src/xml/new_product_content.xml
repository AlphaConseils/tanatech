<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="tanatech_website.new_products_snippet">
        <section class="new_products_section py-5">
            <div class="container">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h2 class="fw-bold">New products</h2>
                        <p class="text-muted">Discover our new solar kits</p>
                    </div>
                    <div>
                        <a href="/shop" class="btn btn-primary">See all</a>
                    </div>
                </div>

                <!-- Grille des produits -->
                <!-- <div class="row g-4"> -->
                <div class="owl-carousel owl-theme new-product-carousel">
                    <t t-foreach="result.products" t-as="product" t-key="product.id">
                        <div class="item px-2">
                            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative">
                                <!-- Badge new -->
                                <span class="badge bg-info position-absolute top-0 start-0 m-2">New</span>

                                <!-- Image -->
                                <div class="ratio ratio-1x1">
                                    <t t-if="product.image_1920">
                                        <img t-att-src="'data:image/png;base64,' + product.image_1920" class="img-fluid object-fit-cover w-100 h-100 img-product" t-att-alt="product.name" />
                                    </t>
                                    <t t-else="">
                                        <img src="/web/image/placeholder.png" class="img-fluid object-fit-cover w-100 h-100 img-product" alt="Image par défaut" />
                                    </t>
                                </div>

                                <!-- Infos produit -->
                                <div class="card-body bg-product">
                                    <h6 class="fw-bold mb-1">
                                        <t t-esc="product.name"/>
                                    </h6>
                                    <!-- <small class="text-muted d-block mb-2">Variante</small> -->
                                    <div class="mb-2">
                                        <span class="text-muted text-decoration-line-through me-2">3 529 000 Ar</span>
                                        <span class="fw-bold text-dark">3 000 000 Ar</span>
                                    </div>
                                    <!-- <div class="d-flex justify-content-between align-items-center">
                                        <button class="btn btn-outline-success btn-sm">Ajouter au panier</button>
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-warning">−</button>
                                            <input type="text" value="1" class="text-center" style="width: 40px;" />
                                            <button class="btn btn-warning">+</button>
                                        </div>
                                    </div> -->
                                </div>
                            </div>
                        </div>
                    </t>
                </div>

            </div>
        </section>
    </t>
</templates>
