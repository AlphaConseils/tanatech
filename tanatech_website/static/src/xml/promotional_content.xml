<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="tanatech_website.promotional_snippet">
        <section class="promotions_section p-5">
            <div class="container-wide">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h2 class="fw-bold">Our promotional offers</h2>
                        <p class="text-muted">Discover our discounted solar kits</p>
                    </div>
                    <a href="/shop" class="btn btn-primary">See all</a>
                </div>

                <!-- Swiper Container -->
                <div class="swiper promotions-carousel">
                    <div class="swiper-wrapper">
                        <t t-foreach="result.products" t-as="product" t-key="product.id">
                            <div class="swiper-slide">
                                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative bg-product p-3">
                                    <img t-att-src="product.image_url" class="card-img-top" />
                                    <div class="card-body shadow-none bg-product p-0">
                                        <span class="badge bg-danger position-absolute m-2" style="z-index: 2; left: 5%; top: 5%;">-15%</span>
                                        <div class="ratio ratio-1x1">
                                            <t t-if="product.image_512">
                                                <img t-att-src="'data:image/png;base64,' + product.image_512" class="img-fluid object-fit-cover w-100 h-100 img-product" t-att-alt="product.name" />
                                            </t>
                                            <t t-else="">
                                                <img src="/web/image/placeholder.png" class="img-fluid object-fit-cover w-100 h-100 img-product" alt="Image par défaut" />
                                            </t>
                                        </div>

                                        <div class="mt-3 d-flex justify-content-between align-items-center mb-2">
                                            <h6 class="fw-bold product-title text-truncate w-50">
                                                <t t-esc="product.name"/>
                                            </h6>
                                            <del class="text-muted">3529000 Ar</del>
                                        </div>
                                        
                                        <!-- <p class="text-muted">Variante</p> -->
                                        <p class="text-end">
                                            <strong class="ms-2 text-dark">3000000 Ar</strong>
                                        </p>

                                        <div id="add_to_cart_wrap" class="d-flex align-items-center justify-content-between">
                                            <button data-animation-selector=".o_wsale_product_images" type="submit"
                                                class="btn btn-primary btn w-50 js_check_product a-submit d-flex align-items-center justify-content-center p-0 py-2">
                                                <span class="text-nowrap fw-bolder text-white" style="font-size: 10px;">Add to cart</span>
                                            </button>
                                            <div t-attf-class="css_quantity input-group input-group-sm ms-2 align-middle"
                                                contenteditable="false" style="max-width: 120px; height: 30px;">
                                                <a t-attf-href="#"
                                                    class="btn btn-link btn-sm js_add_cart_json bg-o-color-2 text-white"
                                                    aria-label="Remove one" title="Remove one">
                                                    <i class="fa fa-minus" />
                                                </a>
                                                <input type="text"
                                                    class="form-control quantity text-center bg-o-color-2 text-white"
                                                    data-min="1" name="add_qty" t-att-value="1" style="max-width: 50px;" />
                                                <a t-attf-href="#"
                                                    class="btn btn-link btn-sm float_left js_add_cart_json bg-o-color-2 text-white"
                                                    aria-label="Add one" title="Add one">
                                                    <i class="fa fa-plus" />
                                                </a>
                                            </div>
                                        </div>
                                        <!-- <button class="btn btn-primary">Add to cart</button>
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-warning">−</button>
                                            <input type="text" value="1" class="text-center" style="width: 40px;" />
                                            <button class="btn btn-warning">+</button>
                                        </div> -->
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>

                    <div class="swiper-bottom-controls">
                        <div class="swiper-pagination"></div>
                        <div class="swiper-navigation-buttons">
                            <div class="swiper-button-prev"></div>
                            <div class="swiper-button-next"></div>
                        </div>
                    </div>
                    
                </div>
            </div>
        </section>

    </t>
</templates>
