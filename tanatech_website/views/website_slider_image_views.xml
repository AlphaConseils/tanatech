<odoo>
  <!-- Form view -->
  <record id="view_slider_image_form" model="ir.ui.view">
    <field name="name">slider.image.form</field>
    <field name="model">website.slider.image</field>
    <field name="arch" type="xml">
      <form string="Image of slider">
        <sheet>
          <group>
            <field name="title"/>
            <field name="image" widget="image" class="oe_avatar w-auto float-start"/>
             <div class="text-danger o_form_label">
                ⚠️ L'image doit être en 1920x550 px
            </div>
            <field name="website_published"/>
            <field name="sequence"/>
            <field name="website_id"/>
            <field name="note" nolabel="1"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_slider_image_tree" model="ir.ui.view">
    <field name="name">slider.image.list</field>
    <field name="model">website.slider.image</field>
    <field name="arch" type="xml">
      <list>
        <field name="title"/>
        <field name="website_published"/>
        <field name="sequence"/>
      </list>
    </field>
  </record>

  <record id="action_slider_image" model="ir.actions.act_window">
    <field name="name">Images of Slider</field>
    <field name="res_model">website.slider.image</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_image_silder_settings" name="Imgae" parent="website.menu_website_global_configuration" sequence="50">

    <menuitem id="menu_slider_image" name="Images of Slider" action="action_slider_image"/>
  </menuitem>
</odoo>
