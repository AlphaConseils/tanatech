<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <template id="product_template" name="tanatech product template" inherit_id="website_sale.products_item">
        <xpath expr="//form" position="attributes">
            <attribute name="class" add="p-2 bg-product" separator=" " />
        </xpath>
        <xpath expr="//span[@t-field='image_holder.image_1920']" position="attributes">
            <attribute name="t-options">{'widget': 'image', 'preview_image': image_type, 'itemprop':
                'image', 'class': 'h-100 w-100 position-absolute img-product'}</attribute>
        </xpath>

        <xpath expr="//div[@class='o_wsale_product_information_text']" position="attributes">
            <attribute name="class" add="d-flex justify-content-between align-items-center"
                separator=" " />
        </xpath>

        <xpath expr="//div/h6" position="after">
            <div class="d-flex justify-content-end align-items-end gap-2 flex-wrap">
                <t t-set="template_price_vals" t-value="get_product_prices(product)" />
                <div class="product_price" itemprop="offers" itemscope="itemscope"
                    itemtype="http://schema.org/Offer">
                    <t
                        t-if="'base_price' in template_price_vals and (template_price_vals['base_price'] &gt; template_price_vals['price_reduce']) and (template_price_vals['price_reduce'] or not website.prevent_zero_price_sale)">
                        <del t-attf-class="text-muted me-1 h6 mb-2" style="white-space: nowrap; font-style: normal;">
                            <span class="small" t-esc="template_price_vals['base_price']"
                                t-options="{'widget': 'monetary', 'display_currency': website.currency_id}" />
                        </del>
                    </t>
                    <span itemprop="price" style="display:none;"
                        t-esc="template_price_vals['price_reduce']" />
                    <span itemprop="priceCurrency" style="display:none;"
                        t-esc="website.currency_id.name" />
                </div>
            </div>
        </xpath>

        <xpath expr="//h6" position="attributes">
            <attribute name="class" add="fw-bolder text-truncate w-50 prod-name" separator=" " />
        </xpath>

        <xpath expr="//div[2]//div[2]//em" position="attributes">
            <attribute name="class" add="d-none" separator=" " />
        </xpath>

        <xpath expr="//span[hasclass('h6') and hasclass('mb-0')][1]" position="attributes">
            <attribute name="class" add="fw-bolder price" separator=" " />
        </xpath>

        <xpath expr="//span[hasclass('h6') and hasclass('mb-0') and hasclass('fw-bolder')]"
            position="before">
            <span class="fw-normal"></span>
        </xpath>

        <xpath expr="//div[@class='product_price']" position="attributes">
            <attribute name="class" add="w-100 d-flex justify-content-end align-items-center"
                separator=" " />
        </xpath>
        <xpath expr="//div[contains(@class, 'o_wsale_product_sub')]" position="attributes">
            <attribute name="class">
                o_wsale_product_sub d-flex justify-content-end align-items-end gap-2 flex-wrap
            </attribute>
        </xpath>

        <xpath expr="//div/div[2]" position="after">
            <!-- Bouton Ajouter au panier -->
            <div t-if="product._is_add_to_cart_possible()" class="mt-2"
                t-att-data-product-id="product.product_variant_ids[0].id if product.product_variant_ids else product.id">
                <div class="d-flex align-items-stretch gap-2 overflow-hidden">
                    <button type="button"
                        class="btn btn-primary rounded-3 flex-grow-1 tana-add-to-cart d-flex align-items-center justify-content-center gap-1"
                        title="Add to cart">
                        <span class="fw-bold text-white text-nowrap tana-btn-label">Add to cart</span>
                    </button>
                    <div class="tana-qty-group d-flex align-items-stretch rounded-3 overflow-hidden" contenteditable="false">
                        <a href="#" class="tana-qty-minus text-white" aria-label="Remove one" title="Remove one">
                            <i class="fa fa-minus"/>
                        </a>
                        <input type="text"
                            class="tana-qty text-center text-white border-0 bg-transparent fw-bold"
                            data-min="1" value="1"/>
                        <a href="#" class="tana-qty-plus text-white" aria-label="Add one" title="Add one">
                            <i class="fa fa-plus"/>
                        </a>
                    </div>
                </div>
            </div>
        </xpath>
        
    </template>

    <template id="similar_protduct_template" name="Produit similaire"
        inherit_id="website_sale.alternative_products">
        <xpath expr="//div[hasclass('css_non_editable_mode_hidden')]" position="before">
            <h1 class="my-5">Similar products</h1>
        </xpath>

    </template>

    <template id="tanatech_offer_template" name="offre Tanatech">
        <section class="s_tanatech_offer">
            <div class="container-fluid my-5">
                <div class="row px-5">
                    <span>Offers</span>
                    <h1>Solar Energy</h1>
                    <p>Découvrez nos solutions solaires fiables et accessibles pour un avenir plus
                        vert à Madagascar.</p>
                    <div class="d-flex">
                        <buton class="btn btn-primary me-3 shadow-sm">
                            <a class="text-decoration-none text-white">Acheter</a>
                        </buton>
                        <buton class="btn btn-warning shadow-sm">
                            <a class="text-decoration-none text-dark">Contact</a>
                        </buton>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <template id="tanatech_decovery_template" name="decovery Tanatech">
        <section class="s_tanatech_decovery">
            <div class="container-fluid my-5">
                <div class="row px-5">
                    <div class="col-md-6">
                        <div class="w-75">
                            <h1>Lorem, ipsum dolor sit amet consectetur adipisicing elit. Autem,
                                molestias.</h1>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <p>Lorem ipsum, dolor sit amet consectetur adipisicing elit. Animi nemo
                            eius, minus quis facere necessitatibus odit modi! Quisquam, perferendis
                            laudantium dignissimos reiciendis porro quae vitae facilis ex vel, alias
                            aperiam!</p>
                        <div class="d-flex">
                            <buton class="btn btn-primary me-3 shadow-sm">
                                <a class="text-decoration-none text-white">Acheter maintenant</a>
                            </buton>
                            <buton class="btn btn-warning shadow-sm">
                                <a class="text-decoration-none text-dark">Discuter</a>
                            </buton>
                        </div>
                    </div>

                </div>
            </div>
        </section>
    </template>

    <template id="tanatech_add_grid_or_list_option" name="Tanatech grid or list option" inherit_id="website_sale.add_grid_or_list_option">
        <xpath expr="//div[1]" position="attributes">
             <attribute name="t-attf-class" add="d-none d-md-flex" separator=" "/>
        </xpath>
    </template>

</odoo>