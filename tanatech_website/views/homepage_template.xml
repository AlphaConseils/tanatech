<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="tanatech_slide_template" name="Tanatech Slider section 2">
        <section class="s_tanatech_slider">
            <t t-set="slider_images"
                t-value="request.env['website.slider.image'].search([('website_published', '=', True), ('website_id', '=', request.website.id)], order='sequence')" />
            <t t-set="carousel_id" t-value="'carouselTanatech%s' % int(time.time() * 1000)" />

            <div t-att-id="carousel_id" class="carousel slide" data-bs-ride="carousel">

                <!-- Indicators -->
                <div class="carousel-indicators">
                    <t t-foreach="slider_images" t-as="slide">
                        <button type="button"
                            t-att-data-bs-target="'#' + carousel_id"
                            t-att-data-bs-slide-to="slide_index"
                            t-att-class="'active' if slide_index == 0 else ''"
                            t-att-aria-current="'true' if slide_index == 0 else None"
                            t-att-aria-label="'Slide %s' % (slide_index + 1)" />
                    </t>
                </div>

                <!-- Slides -->
                <div class="carousel-inner">
                    <t t-foreach="slider_images" t-as="slide">
                        <div t-att-class="'carousel-item' + (' active' if slide_index == 0 else '')">
                            <div class="slide-bg"
                                t-attf-style="background-image: linear-gradient(rgba(0,0,0,0.45), rgba(0,0,0,0.45)), url(#{slide.image and 'data:image/png;base64,' + slide.image.decode() or '/tanatech_website/static/src/img/image1.jpeg'});" />
                            <div class="carousel-caption-custom container">
                                <div class="row align-items-center h-100">
                                    <div class="col-12 col-md-6">
                                        <p class="title-slider lh-1 mb-3" t-field="slide.title" />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <p class="slide-note" t-field="slide.note" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>

                <!-- Contrôles -->
                <button class="carousel-control-prev" type="button"
                    t-att-data-bs-target="'#' + carousel_id" data-bs-slide="prev">
                    <div class="arrow rounded d-flex justify-content-center align-items-center">
                        <i class="fa-solid fa-arrow-left" style="color:#000;" />
                    </div>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button"
                    t-att-data-bs-target="'#' + carousel_id" data-bs-slide="next">
                    <div class="arrow rounded d-flex justify-content-center align-items-center">
                        <i class="fa-solid fa-arrow-right" style="color:#000;" />
                    </div>
                    <span class="visually-hidden">Next</span>
                </button>
            </div>

            <script type="text/javascript">
            document.addEventListener('DOMContentLoaded', function () {
                var el = document.getElementById('<t t-esc="carousel_id"/>');
                if (!el) return;
                if (typeof bootstrap !== 'undefined' &amp;&amp; bootstrap.Carousel) {
                    new bootstrap.Carousel(el, { interval: 5000, ride: 'carousel' });
                } else if (typeof $ !== 'undefined' &amp;&amp; $.fn.carousel) {
                    $(el).carousel({ interval: 5000, ride: 'carousel' });
                }
            });
        </script>
        </section>
    </template>

    <template id="tanatech_publicity_template" name="Tanatech publicity section">
        <section class="s_tanatech_publicity o_colored_level">
            <div class="container-xl mx-auto py-3 my-5 px-3 px-md-4">
                <div class="row g-3">
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="pub d-flex justify-content-start align-items-center p-3 rounded h-100">
                            <div class="icon rounded-circle d-flex justify-content-center align-items-center shadow-sm flex-shrink-0">
                                <i class="fa-solid fa-sun" style="color: #ffffff;"></i>
                            </div>
                            <span class="ms-3 fs-5 fw-light"><a href="" class="text-decoration-none text-dark">Who is Tanatech</a></span>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="pub d-flex justify-content-start align-items-center p-3 rounded h-100">
                            <div class="icon rounded-circle d-flex justify-content-center align-items-center shadow-sm flex-shrink-0">
                                <i class="fa-solid fa-box" style="color: #ffffff;"></i>
                            </div>
                            <span class="ms-3 fs-5 fw-light"><a href="" class="text-decoration-none text-dark">Home delivery</a></span>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="pub d-flex justify-content-start align-items-center p-3 rounded h-100">
                            <div class="icon rounded-circle d-flex justify-content-center align-items-center shadow-sm flex-shrink-0">
                                <i class="fa-solid fa-basket-shopping" style="color: #ffffff;"></i>
                            </div>
                            <span class="ms-3 fs-5 fw-light"><a href="" class="text-decoration-none text-dark">Authentic products</a></span>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="pub d-flex justify-content-start align-items-center p-3 rounded h-100">
                            <div class="icon rounded-circle d-flex justify-content-center align-items-center shadow-sm flex-shrink-0">
                                <i class="fa-solid fa-shield" style="color: #ffffff;"></i>
                            </div>
                            <span class="ms-3 fs-5 fw-light"><a href="" class="text-decoration-none text-dark">Guarantee</a></span>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <template id="tanatech_brand_template" name="Grande marque">
        <section class="s_tanatech_brand o_colored_level">
            <div class="container-xl mx-auto py-4 px-3 px-md-4">
                <h2 class="text-center fw-bold mb-4 mb-md-5">Our top brands</h2>

                <!-- Carousel : flèche | slides | flèche -->
                <div class="brand-carousel-wrap d-flex align-items-center gap-2 gap-md-3">
                    <button class="brand-nav-prev brand-nav-btn d-none d-sm-flex" type="button" aria-label="Précédent">
                        <i class="fa fa-chevron-left"/>
                    </button>

                    <div class="swiper swiper_client flex-grow-1 overflow-hidden">
                        <div class="swiper-wrapper o_not_editable">
                            <t t-foreach="request.env['partner.logo'].sudo().search([('website_published','=',True)])"
                                t-as="logo">
                                <div class="swiper-slide">
                                    <div class="brand-logo-card">
                                        <img t-att-src="'/web/image/partner.logo/%s/image' % logo.id"
                                            class="img img-fluid"
                                            t-att-alt="logo.name or ''"/>
                                    </div>
                                </div>
                            </t>
                            <t t-foreach="request.env['partner.logo'].sudo().search([('website_published','=',True)])"
                                t-as="logo">
                                <div class="swiper-slide">
                                    <div class="brand-logo-card">
                                        <img t-att-src="'/web/image/partner.logo/%s/image' % logo.id"
                                            class="img img-fluid"
                                            t-att-alt="logo.name or ''"/>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>

                    <button class="brand-nav-next brand-nav-btn d-none d-sm-flex" type="button" aria-label="Suivant">
                        <i class="fa fa-chevron-right"/>
                    </button>
                </div>

                <!-- Pagination en dessous -->
                <div class="swiper-pagination brand-nav-pagination mt-3 text-center"></div>
            </div>
        </section>
    </template>
    
</odoo>