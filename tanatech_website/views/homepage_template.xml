<?xml version='1.0' encoding='utf-8'?>
<odoo> 
    <template id="tanatech_publicity_template" name="Tanatech publicity section">
        <section class="s_tanatech_publicity o_colored_level">
            <div class="container-xl mx-auto py-3 my-5 px-3 px-md-4">
                <div class="row g-3">
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="pub d-flex justify-content-start align-items-center p-3 rounded h-100">
                            <div class="icon rounded-circle d-flex justify-content-center align-items-center shadow-sm flex-shrink-0">
                                <i class="fa fa-sun-o" style="color: #ffffff;"></i>
                            </div>
                            <span class="ms-3 fs-5 fw-light"><a href="" class="text-decoration-none text-dark">Who is Tanatech</a></span>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="pub d-flex justify-content-start align-items-center p-3 rounded h-100">
                            <div class="icon rounded-circle d-flex justify-content-center align-items-center shadow-sm flex-shrink-0">
                                <i class="fa fa-archive" style="color: #ffffff;"></i>
                            </div>
                            <span class="ms-3 fs-5 fw-light"><a href="" class="text-decoration-none text-dark">Home delivery</a></span>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="pub d-flex justify-content-start align-items-center p-3 rounded h-100">
                            <div class="icon rounded-circle d-flex justify-content-center align-items-center shadow-sm flex-shrink-0">
                                <i class="fa fa-shopping-basket" style="color: #ffffff;"></i>
                            </div>
                            <span class="ms-3 fs-5 fw-light"><a href="" class="text-decoration-none text-dark">Authentic products</a></span>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="pub d-flex justify-content-start align-items-center p-3 rounded h-100">
                            <div class="icon rounded-circle d-flex justify-content-center align-items-center shadow-sm flex-shrink-0">
                                <i class="fa fa-shield" style="color: #ffffff;"></i>
                            </div>
                            <span class="ms-3 fs-5 fw-light"><a href="" class="text-decoration-none text-dark">Guarantee</a></span>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <template id="tanatech_brand_template" name="Grande marque">
        <section class="s_tanatech_brand o_colored_level">
            <div class="container-xl mx-auto py-4 px-3 px-md-4">
                <h2 class="text-center fw-bold mb-4 mb-md-5">Our top brands</h2>

                <!-- Carousel : flèche | slides | flèche -->
                <div class="brand-carousel-wrap d-flex align-items-center gap-2 gap-md-3">
                    <button class="brand-nav-prev brand-nav-btn d-none d-sm-flex" type="button" aria-label="Précédent">
                        <i class="fa fa-chevron-left"/>
                    </button>

                    <div class="swiper swiper_client flex-grow-1 overflow-hidden">
                        <div class="swiper-wrapper o_not_editable">
                            <t t-foreach="request.env['partner.logo'].sudo().search([('website_published','=',True)])"
                                t-as="logo">
                                <div class="swiper-slide">
                                    <div class="brand-logo-card">
                                        <img t-att-src="'/web/image/partner.logo/%s/image' % logo.id"
                                            class="img img-fluid"
                                            t-att-alt="logo.name or ''"/>
                                    </div>
                                </div>
                            </t>
                            <t t-foreach="request.env['partner.logo'].sudo().search([('website_published','=',True)])"
                                t-as="logo">
                                <div class="swiper-slide">
                                    <div class="brand-logo-card">
                                        <img t-att-src="'/web/image/partner.logo/%s/image' % logo.id"
                                            class="img img-fluid"
                                            t-att-alt="logo.name or ''"/>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>

                    <button class="brand-nav-next brand-nav-btn d-none d-sm-flex" type="button" aria-label="Suivant">
                        <i class="fa fa-chevron-right"/>
                    </button>
                </div>

                <!-- Pagination en dessous -->
                <div class="swiper-pagination brand-nav-pagination mt-3 text-center"></div>
            </div>
        </section>
    </template>
    
</odoo>