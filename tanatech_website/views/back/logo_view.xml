<odoo>

    <record id="view_partner_logo_tree" model="ir.ui.view">
        <field name="name">partner.logo.list</field>
        <field name="model">partner.logo</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="image" widget="image" options="{'size': [80, 80]}"/>
                <field name="website_published"/>
            </list>
        </field>
    </record>

    <record id="view_partner_logo_form" model="ir.ui.view">
        <field name="name">partner.logo.form</field>
        <field name="model">partner.logo</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="image" widget="image" options="{'size': [80, 80]}"/>
                        <field name="website_published"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_partner_logo" model="ir.actions.act_window">
        <field name="name">Logos clients</field>
        <field name="res_model">partner.logo</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_partner_logo_root"
        name="Logos clients"
        parent="website.menu_content"
        sequence="20"
        action="action_partner_logo"/>

</odoo>
