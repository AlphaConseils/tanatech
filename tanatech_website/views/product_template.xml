<?xml version='1.0' encoding='utf-8'?>
<odoo>
    
    <template id="product_template" name="tanatech product template" inherit_id="website_sale.products_item">
        <xpath expr="//form" position="attributes">
           <attribute name="class" add="p-2 bg-product" separator=" " />
        </xpath>
        <xpath expr="//span[@t-field='image_holder.image_1920']" position="attributes">
            <attribute name="t-options">{'widget': 'image', 'preview_image': image_type, 'itemprop': 'image', 'class': 'h-100 w-100 position-absolute img-product'}</attribute>
        </xpath>

        <xpath expr="//h6" position="attributes">
           <attribute name="class" add="fw-bolder" separator=" " />
        </xpath>

        <xpath expr="//span[hasclass('h6') and hasclass('mb-0')][1]" position="attributes">
           <attribute name="class" add="fw-bolder price" separator=" " />
        </xpath>

        <xpath expr="//span[hasclass('h6') and hasclass('mb-0') and hasclass('fw-bolder')]" position="before">
           <span class="fw-light">Variante</span>
        </xpath>

        <xpath expr="//div[@class='product_price']" position="attributes">
           <attribute name="class" add="w-100 d-flex justify-content-between" separator=" " />
        </xpath>
    </template>

</odoo>