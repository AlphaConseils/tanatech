   <template id="tanatech_product_template" name="Produit Tanatech" inherit_id="website_sale.product">
      <xpath expr="//h1" position="replace"></xpath>
      <xpath expr="//t/t/div/section/div[2]/div[2]/t[2]" position="replace"></xpath>
      <xpath expr="//t/t/div/section/div[2]/div[2]/div[1]" position="replace"></xpath>
      <xpath expr="//t/t/div/section/div[2]/div[2]/form/div/div[1]/t[1]" position="replace">
         <div class="d-flex justify-content-between align-items-start">
            <h1 itemprop="name" t-field="product.name" class="mt-2">Product Name</h1>
            <t t-call="website_sale.product_price"/>
         </div>
         <t t-if="is_view_active('website_sale.product_comment')">
            <a href="#o_product_page_reviews" class="o_product_page_reviews_link text-decoration-none">
               <t t-call="portal_rating.rating_widget_stars_static">
                     <t t-set="rating_avg" t-value="product.rating_avg"/>
                     <t t-set="trans_text_plural">%s reviews</t>
                     <t t-set="trans_text_singular">%s review</t>
                     <t t-set="rating_count" t-value="(trans_text_plural if product.rating_count &gt; 1 else trans_text_singular) % product.rating_count"/>
               </t>
            </a>
         </t>
         <div t-field="product.description_ecommerce" class="oe_structure my-3" placeholder="A detailed, formatted description to promote your product on this page. Use '/' to discover more features."/>
      </xpath>
      
