<odoo>
    <template id="tanatech_slide_template" name="Home slide GreenShop">
        <section class="s_tanatech_slider home_slide_section">
            <t t-set="current_website" t-value="request.env['website'].get_current_website()" />
            <t t-set="slides"
                t-value="request.env['website.slider.image'].sudo().search([('website_published', '=', True),('website_id', '=', current_website.id)], order='sequence')" />

            <t t-if="slides">
                <div class="container-fluid">
                    <div id="carouselExampleIndicators" class="carousel slide" data-bs-ride="carousel">

                        <!-- Slides -->
                        <div class="carousel-inner">
                            <t t-foreach="slides" t-as="slide" t-index="i">
                                <div t-att-class="'carousel-item' + (' active' if i == 0 else '')">
                                    <div class="slide-bg"
                                        t-attf-style="background-image: linear-gradient(rgba(0,0,0,0.45), rgba(0,0,0,0.45)), url(#{slide.image and 'data:image/png;base64,' + slide.image.decode() or '/tanatech_website/static/src/img/image1.jpeg'});" />
                                    <div class="slide-content container">
                                        <div class="row align-items-center h-100">
                                            <div class="col-12 col-md-6">
                                                <p class="title-slider lh-1 mb-3 text-white"
                                                    t-field="slide.title" />
                                            </div>
                                            <div class="col-12 col-md-6">
                                                <p class="slide-note text-white" t-field="slide.note" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>

                        <!-- Contrôles -->
                        <button class="carousel-control-prev" type="button"
                            data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
                            <div class="arrow rounded d-flex justify-content-center align-items-center">
                                <i class="fa-solid fa-arrow-left" style="color:#000;" />
                            </div>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button"
                            data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
                            <div class="arrow rounded d-flex justify-content-center align-items-center">
                                <i class="fa-solid fa-arrow-right" style="color:#000;" />
                            </div>
                            <span class="visually-hidden">Next</span>
                        </button>
                    </div>
                </div>
                
            </t>

            <t t-else="">
                <div class="container">
                    <div class="alert alert-info mt-3">
                        <h4>No slides configured</h4>
                        <p>Add slides in Website → Configuration → Slider Images</p>
                    </div>
                </div>
            </t>
        </section>
    </template>
    <template id="category_template_green_shop" name="Category GreenShop">
        <section class="categories_section">
            <div class="container">
                <div class="alert alert-info">
                    <h2 class="">Categories</h2>
                    <h4>Discover our selection of reliable solar solutions.</h4>
                </div>
            </div>
        </section>
    </template>

    <template id="new_products" name="New products GreenShop">
        <section class="new_products_section">
            <div class="container">
                <div class="alert alert-warning">
                    <h2 class="">Our new products</h2>
                    <h4>Discover our current products.</h4>
                </div>
            </div>
        </section>
    </template>

    <template id="promotional_products" name="Promotional GreenShop">
        <section class="promotions_section">
            <div class="container">
                <div class="alert alert-warning">
                    <h2 class="">Our Promotional products</h2>
                    <h4>Discover our promotional products.</h4>
                </div>
            </div>
        </section>
    </template>


    <template id="snippet_greenshop_groups" name="GreenShop Snippets">
        <t t-call="website.snippet_group">
            <t t-set="name">GreenShop</t>            
            <t t-set="category">green_shop</t>           
        </t>
    </template>


    <template id="greenshop_snippet" inherit_id="website.snippets" name="GreenShop Snippet">
        <xpath expr="//snippets[@id='snippet_groups']" position="inside">
            <!-- <t t-snippet="tanatech_website.home_slide_template_green_shop" t-thumbnail="" t-snippet-category="green_shop"/> -->
            <t t-snippet="tanatech_website.category_template_green_shop" t-thumbnail="" t-snippet-category="green_shop"/>
            <t t-snippet="tanatech_website.new_products" t-thumbnail="" t-snippet-category="green_shop"/>
            <t t-snippet="tanatech_website.promotional_products" t-thumbnail="" t-snippet-category="green_shop"/>
            <!-- <t t-snippet="tanatech_website.tanatech_slide_template" t-thumbnail="/website/static/src/img/snippets_thumbs/s_cover.svg"/> -->
            <t t-snippet="tanatech_website.tanatech_publicity_template" t-thumbnail="/website/static/src/img/snippets_thumbs/s_cover.svg"/>
            <!-- <t t-snippet="tanatech_website.faqs_section" t-thumbnail="/website/static/src/img/snippets_thumbs/s_cover.svg"/> -->
            <t t-snippet="tanatech_website.tanatech_offer_template" t-thumbnail="/website/static/src/img/snippets_thumbs/s_cover.svg"/>
            <t t-snippet="tanatech_website.tanatech_decovery_template" t-thumbnail="/website/static/src/img/snippets_thumbs/s_cover.svg"/>
            <t t-snippet="tanatech_website.tanatech_brand_template" t-thumbnail="/website/static/src/img/snippets_thumbs/s_cover.svg"/>
        </xpath>
    </template>


</odoo>