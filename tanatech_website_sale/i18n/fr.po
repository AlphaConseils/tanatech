#. module: tanatech_website_sale
#. odoo-python
#: code:addons/tanatech_website_sale/models/sale_order.py:0
msgid "Sales follow-up — web order confirmed"
msgstr "Suivi commercial — commande web confirmée"

#. module: tanatech_website_sale
#: model:ir.model.fields,help:tanatech_website_sale.field_res_company__website_confirm_delivery_activity_user_ids
#: model:ir.model.fields,help:tanatech_website_sale.field_res_config_settings__website_confirm_delivery_activity_user_ids
msgid ""
"Users receiving an activity on the delivery order when a customer confirms "
"their order on the website. If empty, the activity is assigned to the "
"responsible of the transfer or to the salesperson."
msgstr ""
"Utilisateurs recevant une activité sur le bon de livraison lorsqu'un client "
"confirme sa commande sur le site web. Si vide, l'activité est assignée au "
"responsable du transfert ou au vendeur."

#. module: tanatech_website_sale
#: model:ir.model.fields,help:tanatech_website_sale.field_res_company__website_confirm_invoice_activity_user_ids
#: model:ir.model.fields,help:tanatech_website_sale.field_res_config_settings__website_confirm_invoice_activity_user_ids
msgid ""
"Users receiving an activity on the invoice generated from a web order "
"confirmed by the customer. If empty, the activity is assigned to the "
"accountant of the invoice or to the salesperson."
msgstr ""
"Utilisateurs recevant une activité sur la facture générée depuis une "
"commande web confirmée par le client. Si vide, l'activité est assignée au "
"comptable de la facture ou au vendeur."

#. module: tanatech_website_sale
#: model:ir.model.fields,help:tanatech_website_sale.field_res_company__website_confirm_sale_activity_user_ids
#: model:ir.model.fields,help:tanatech_website_sale.field_res_config_settings__website_confirm_sale_activity_user_ids
msgid ""
"Users receiving an activity on the quotation when a customer confirms their "
"order on the website. If empty, the activity is assigned to the salesperson "
"of the order."
msgstr ""
"Utilisateurs recevant une activité sur le devis lorsqu'un client confirme sa "
"commande sur le site web. Si vide, l'activité est assignée au vendeur de la "
"commande."

#. module: tanatech_website_sale
#: model_terms:ir.ui.view,arch_db:tanatech_website_sale.res_config_settings_view_form
