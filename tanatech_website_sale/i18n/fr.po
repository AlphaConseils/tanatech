#. module: tanatech_website_sale
#: model_terms:ir.ui.view,arch_db:tanatech_website_sale.payment_manual_message
msgid "Cancel"
msgstr "Annuler"

#. module: tanatech_website_sale
#: model:ir.model.fields,help:tanatech_website_sale.field_sale_order__website_manual_payment_requested
msgid ""
"Checked when the customer validated their cart while online payment was not "
"available: the quotation has been sent to the sales team, which will contact "
"the customer to finalize the order."
msgstr ""
"Coché lorsque le client a validé son panier alors que le paiement en ligne "
"n'était pas disponible : le devis a été transmis à l'équipe commerciale, qui "
"contactera le client pour finaliser la commande."

#. module: tanatech_website_sale
#: model:ir.model.fields,help:tanatech_website_sale.field_sale_order__website_customer_confirmed
msgid ""
"Checked when the order was confirmed by the customer from the website "
"(eCommerce payment or signature on the portal)."
msgstr ""
"Coché lorsque la commande a été confirmée par le client depuis le site web "
"(paiement e-commerce ou signature sur le portail)."

#. module: tanatech_website_sale
#: model_terms:ir.ui.view,arch_db:tanatech_website_sale.payment_manual_message
msgid "Close"
msgstr "Fermer"

#. module: tanatech_website_sale
#: model:ir.model.fields,field_description:tanatech_website_sale.field_sale_order__website_customer_confirmed
msgid "Confirmed by Customer (Website)"
msgstr "Confirmée par le client (site web)"

#. module: tanatech_website_sale
#. odoo-python
#: code:addons/tanatech_website_sale/models/sale_order.py:0
msgid ""
"Customer %(customer)s confirmed order %(order)s on the website. Please follow"
" up on this sale."
msgstr ""
"Le client %(customer)s a confirmé la commande %(order)s sur le site web. "
"Merci d'assurer le suivi de cette vente."

#. module: tanatech_website_sale
#. odoo-python
