<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="inherit_approval_category_view_form" model="ir.ui.view">
        <field name="name">approval.category.view.form.inherit</field>
        <field name="model">approval.category</field>
        <field name="inherit_id" ref="approvals.approval_category_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sequence_code']" position="after">
                <field name="hide_price_and_total"/>
                <field name="activity_user_ids" widget="many2many_tags" invisible="approval_type != 'create_expenses'"/>
            </xpath>
        </field>
    </record>
</odoo>
