<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_project_form_hide_partner" model="ir.ui.view">
        <field name="name">project.project.form.hide.partner</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group/group[2]" position="inside">
                <field name="hide_partner" groups="tanatech_project.group_hide_partner_manager" />
            </xpath>
            <field name="partner_id" position="attributes">
                <attribute name="invisible">hide_partner</attribute>
            </field>
        </field>
    </record>

    <record id="view_project_inherit_tanatech_project" model="ir.ui.view">
        <field name="name">project.project.list.inherit</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project" />
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='partner_id']" position="after">
                <field name="hide_partner" invisible="1" />
            </xpath>
            <xpath expr="//list/field[@name='partner_id']" position="attributes">
                <attribute name="invisible">hide_partner</attribute>
            </xpath>
        </field>
    </record>

    <record id="project_view_kanban_inherit_tanatech_project" model="ir.ui.view">
        <field name="name">tanatech.project.view.kanban.inherit</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_kanban" />
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="hide_partner" />
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="invisible">hide_partner</attribute>
            </xpath>
        </field>
    </record>

</odoo>