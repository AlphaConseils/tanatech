<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="broadcast_channels_action" model="ir.actions.act_window">
        <field name="name">Broadcast Channels</field>
        <field name="res_model">broadcast.channel</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                add new broadcasting channels
            </p>
        </field>
    </record>
    <record id="broadcast_channels_list" model="ir.ui.view">
        <field name="name">broadcast.channels.list</field>
        <field name="model">broadcast.channel</field>
        <field name="arch" type="xml">
            <list editable="bottom" string="Broadcast Channels">
                <field name="name" />
                <field name="color" widget="color_picker" />
            </list>
        </field>
    </record>
    <menuitem
        id="broadcast_channels_menu"
        name="Broadcast Channels"
        parent="social.menu_social_configuration"
        action="broadcast_channels_action"
        sequence="45" />
</odoo>