<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_quotation_tree_inherit" model="ir.ui.view">
        <field name="name">tanatech_sale_view_quotation_tree_inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="attributes">
                <attribute name="groups">tanatech_sale.commercial_group</attribute>
            </field>
        </field>
    </record>

    <record id="view_order_form_inherit" model="ir.ui.view">
        <field name="name">sale.view.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="after">
                <field name="is_service" invisible="1"/>
            </xpath>
            <xpath expr="//button[8]" position="after">
                <field name="show_action_add_service_charge" invisible="1
                
                
                
                
                
                
                
                " />
                <button name="action_add_service_charge" type="object" string="Ajout frais de service" invisible="show_action_add_service_charge==False"/>
            </xpath>
            <xpath expr="//header" position="attributes">
                <attribute name="groups">tanatech_sale.commercial_group</attribute>
            </xpath>
            <group name="partner_details" position="attributes">
                <attribute name="groups">tanatech_sale.commercial_group</attribute>
            </group>
            <group name="partner_details" position="before">
                <field name="is_commercial" invisible="1"/>
                <field name="is_office_design" invisible="1"/>
                <field name="can_edit_pricelist" invisible="1"/>
            </group>
            <field name="partner_id" position="attributes">
                <attribute name="required">is_commercial</attribute>
            </field>
            <field name="partner_invoice_id" position="attributes">
                <attribute name="required">is_commercial</attribute>
            </field>
            <field name="partner_shipping_id" position="attributes">
                <attribute name="required">is_commercial</attribute>
            </field>
            <field name="pricelist_id" position="attributes">
                <attribute name="required">is_commercial and can_edit_pricelist</attribute>
                <attribute name="readonly">not can_edit_pricelist</attribute>
                <attribute name="invisible">not is_commercial</attribute>
            </field>
            <xpath expr="//label[@for='pricelist_id']" position="attributes">
                <attribute name="invisible">not is_commercial</attribute>
            </xpath>
            <button name="action_preview_sale_order" position="attributes">
                <attribute name="invisible">is_office_design</attribute>
            </button>
        </field>
    </record>
</odoo>