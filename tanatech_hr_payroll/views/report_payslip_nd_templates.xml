<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 80mm thermal receipt paper format -->
    <record id="paperformat_nd_payslip_ticket" model="report.paperformat">
        <field name="name">ND Payslip Ticket (80mm)</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_width">80</field>
        <field name="page_height">297</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">3</field>
        <field name="margin_bottom">3</field>
        <field name="margin_left">3</field>
        <field name="margin_right">3</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">3</field>
        <field name="dpi">90</field>
    </record>

    <template id="report_nd_payslip">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <!-- The company document layout (e.g. "Boxed") draws a grid on every
                         report table; force-remove any border/background inside the ticket. -->
                    <style>
                        .nd_ticket table, .nd_ticket thead, .nd_ticket tbody,
                        .nd_ticket tr, .nd_ticket th, .nd_ticket td {
                            border: none !important;
                            box-shadow: none !important;
                            background: transparent !important;
                        }
                        .nd_ticket table::before, .nd_ticket table::after {
                            content: none !important;
                            border: none !important;
                        }
                    </style>
                    <div class="page nd_ticket" style="
                        font-family: 'Courier New', Courier, monospace;
                        font-size: 8pt;
                        padding: 1mm;
                        width: 100%;
                        line-height: 1.3;
                    ">

                        <!-- TITLE -->
                        <div style="text-align: center; font-weight: bold; font-size: 13pt; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 2mm;">
                            Payment
                        </div>
                        <div style="border-top: 2px solid #000000; margin-bottom: 2mm;"/>

                        <!-- SECTION: INFORMATION -->
                        <div style="font-weight: bold; text-transform: uppercase; font-size: 8pt; margin-bottom: 0.5mm;">
                            Information
                        </div>
                        <div style="border-top: 1px solid #000000; margin-bottom: 1mm;"/>

                        <table class="o_ignore_layout_styling" style="width: 100%; border-collapse: collapse; font-size: 8pt; margin-bottom: 2mm;">
                            <tr>
                                <td style="padding: 1px 0; width: 38%; vertical-align: top; font-weight: bold;">Month</td>
                                <td style="padding: 1px 0; vertical-align: top; text-transform: uppercase;">
                                    :&#160;<span t-field="o.date_from" t-options="{'format': 'MMMM yyyy'}"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 1px 0; vertical-align: top; font-weight: bold;">Full name</td>
                                <td style="padding: 1px 0; vertical-align: top; text-transform: uppercase; word-break: break-word;">
                                    :&#160;<span t-field="o.employee_id.name"/>
                                </td>
                            </tr>
                        </table>

                        <!-- LINE COMPUTATION -->
                        <!-- Filter out intermediate summary lines by category: Brut (Salaire imposable), Net (Salaire net + SALAIRE NET A PAYER) -->
                        <t t-set="visible_lines"   t-value="o.line_ids.filtered(lambda l: l.appears_on_payslip)"/>
                        <t t-set="deduction_lines" t-value="visible_lines.filtered(lambda l: l.total &lt; 0 and l.category_id.code not in ['NET', 'BRUT', 'GROSS'])"/>
                        <!-- Only income lines with an actual amount: hide the zero-total rows (unused overtime types, etc.) -->
                        <t t-set="income_lines"    t-value="visible_lines.filtered(lambda l: l.total &gt; 0 and l.category_id.code not in ['NET', 'BRUT', 'GROSS'])"/>
                        <t t-set="deduction_total" t-value="sum(deduction_lines.mapped('total'))"/>
                        <t t-set="revenue_total"   t-value="sum(income_lines.mapped('total'))"/>
                        <t t-set="net_salary"      t-value="sum(visible_lines.filtered(lambda l: l.salary_rule_id.code == 'SALNETAP').mapped('total'))"/>

                        <!-- INCOME TABLE HEADER -->
                        <div style="border-top: 1px solid #000000; margin-bottom: 0.5mm;"/>
                        <table class="o_ignore_layout_styling" style="width: 100%; border-collapse: collapse; font-size: 8pt;">
                            <thead>
                                <tr>
                                    <th style="text-align: left;  width: 52%; padding: 1px 0; font-weight: bold; text-transform: uppercase;">Description</th>
                                    <th style="text-align: right; width: 16%; padding: 1px 1mm; font-weight: bold; text-transform: uppercase;">Quantity</th>
                                    <th style="text-align: right; width: 32%; padding: 1px 0; font-weight: bold; text-transform: uppercase;">Total</th>
                                </tr>
                            </thead>
                        </table>

                        <table class="o_ignore_layout_styling" style="width: 100%; border-collapse: collapse; font-size: 8pt;">
                            <tbody>
                                <t t-foreach="income_lines" t-as="line">
                                    <tr>
                                        <td style="padding: 1px 0; width: 52%; text-transform: uppercase; word-break: break-word;">
                                            <t t-if="line.salary_rule_id.code == 'BASIC'">Budget</t>
                                            <t t-else=""><span t-out="line.name"/></t>
                                        </td>
                                        <td style="text-align: right; padding: 1px 1mm; width: 16%;">
                                            <t t-if="line.quantity != 0">
                                                <t t-set="qty_int" t-value="int(line.quantity)"/>
                                                <t t-if="line.quantity == qty_int">
                                                    <span t-out="qty_int"/>
                                                </t>
                                                <t t-else="">
                                                    <t t-set="qty_fmt" t-value="'{:.2f}'.format(line.quantity)"/>
                                                    <span t-out="qty_fmt"/>
                                                </t>
                                            </t>
                                        </td>
                                        <td style="text-align: right; padding: 1px 0; width: 32%;">
                                            <t t-if="line.total != 0">
                                                <t t-set="total_fmt" t-value="'{:,.0f}'.format(line.total).replace(',', '.')"/>
                                                <span t-out="total_fmt"/>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div style="border-top: 1px solid #000000; margin: 0.5mm 0;"/>
                        <div style="text-align: right; font-weight: bold; text-decoration: underline; font-size: 8pt; margin-bottom: 2mm;">
                            Subtotal:&#160;
                            <t t-set="rev_fmt" t-value="'{:,.0f}'.format(revenue_total).replace(',', '.')"/>
                            <span t-out="rev_fmt"/>
                        </div>

                        <!-- DEDUCTION SECTION HEADER (same 3-column layout as the income table) -->
                        <div style="border-top: 1px solid #000000; margin-bottom: 0.5mm;"/>
                        <table class="o_ignore_layout_styling" style="width: 100%; border-collapse: collapse; font-size: 8pt;">
                            <thead>
                                <tr>
                                    <th style="text-align: left;  width: 52%; padding: 1px 0; font-weight: bold; text-transform: uppercase;">Deductions</th>
                                    <th style="text-align: right; width: 16%; padding: 1px 1mm; font-weight: bold; text-transform: uppercase;">Quantity</th>
                                    <th style="text-align: right; width: 32%; padding: 1px 0; font-weight: bold; text-transform: uppercase;">Total</th>
                                </tr>
                            </thead>
                        </table>

                        <!-- DEDUCTION TABLE -->
                        <table class="o_ignore_layout_styling" style="width: 100%; border-collapse: collapse; font-size: 8pt;">
                            <tbody>
                                <t t-foreach="deduction_lines" t-as="line">
                                    <tr>
                                        <td style="padding: 1px 0; width: 52%; text-transform: uppercase; word-break: break-word;">
                                            <span t-out="line.name"/>
                                        </td>
                                        <td style="text-align: right; padding: 1px 1mm; width: 16%;">
                                            <t t-if="line.quantity != 0">
                                                <t t-set="qty_int" t-value="int(line.quantity)"/>
                                                <t t-if="line.quantity == qty_int">
                                                    <span t-out="qty_int"/>
                                                </t>
                                                <t t-else="">
                                                    <t t-set="qty_fmt" t-value="'{:.2f}'.format(line.quantity)"/>
                                                    <span t-out="qty_fmt"/>
                                                </t>
                                            </t>
                                        </td>
                                        <td style="text-align: right; padding: 1px 0; width: 32%;">
                                            <t t-set="total_fmt" t-value="'{:,.0f}'.format(line.total).replace(',', '.')"/>
                                            <span t-out="total_fmt"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div style="border-top: 1px solid #000000; margin: 0.5mm 0;"/>
                        <div style="text-align: right; font-weight: bold; text-decoration: underline; font-size: 8pt; margin-bottom: 2mm;">
                            Subtotal:&#160;
                            <t t-set="ded_fmt" t-value="'{:,.0f}'.format(deduction_total).replace(',', '.')"/>
                            <span t-out="ded_fmt"/>
                        </div>

                        <!-- NET TOTAL BOX -->
                        <div style="border: 2px solid #000000; padding: 2mm; text-align: right; font-weight: bold; font-size: 9pt; margin-bottom: 3mm; text-transform: uppercase;">
                            Total:&#160;
                            <t t-set="net_fmt" t-value="'{:,.0f}'.format(net_salary).replace(',', '.')"/>
                            <span t-out="net_fmt"/>
                        </div>

                        <!-- SIGNATURE -->
                        <div style="font-size: 8pt; margin-top: 4mm;">
                            <strong>Signature</strong>
                            <br/><br/><br/>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_nd_payslip" model="ir.actions.report">
        <field name="name">Undeclared Payment Ticket</field>
        <field name="model">hr.payslip</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tanatech_hr_payroll.report_nd_payslip</field>
        <field name="report_file">tanatech_hr_payroll.report_nd_payslip</field>
        <field name="print_report_name">'Undeclared Payment - %s' % (object.employee_id.name)</field>
        <field name="paperformat_id" ref="tanatech_hr_payroll.paperformat_nd_payslip_ticket"/>
        <field name="attachment"></field>
        <field name="attachment_use" eval="False"/>
    </record>

</odoo>
