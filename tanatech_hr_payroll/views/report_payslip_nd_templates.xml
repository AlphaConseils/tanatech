<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_nd_payslip">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <div class="page" style="
                        font-family: Arial, Helvetica, sans-serif;
                        font-size: 10pt;
                        padding: 15mm 20mm;
                        line-height: 1.6;
                    ">

                        <!-- TITLE -->
                        <div style="text-align: center; font-weight: bold; font-size: 32pt; text-transform: uppercase; letter-spacing: 3px; margin-bottom: 3mm;">
                            Payment
                        </div>

                        <!-- COMPANY NAME -->
                        <div style="text-align: center; font-size: 10pt; margin-bottom: 5mm;">
                            <strong t-out="o.company_id.name"/>
                        </div>

                        <div style="border-top: 2px solid #000000; margin-bottom: 6mm;"/>

                        <!-- SECTION: INFORMATION -->
                        <div style="font-weight: bold; text-transform: uppercase; font-size: 10pt; margin-bottom: 1mm;">
                            Information
                        </div>
                        <div style="border-top: 1px solid #000000; margin-bottom: 4mm;"/>

                        <table style="width: 60%; border-collapse: collapse; font-size: 10pt; margin-bottom: 6mm;">
                            <tr>
                                <td style="padding: 2px 0; width: 35%; font-weight: bold;">Month</td>
                                <td style="padding: 2px 0; text-transform: uppercase;">
                                    <span t-field="o.date_from" t-options="{'format': 'MMMM yyyy'}"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 2px 0; font-weight: bold;">Full name</td>
                                <td style="padding: 2px 0; text-transform: uppercase;">
                                    <span t-field="o.employee_id.name"/>
                                </td>
                            </tr>
                        </table>

                        <!-- LINE COMPUTATION -->
                        <t t-set="visible_lines"   t-value="o.line_ids.filtered(lambda l: l.appears_on_payslip)"/>
                        <t t-set="income_lines"    t-value="visible_lines.filtered(lambda l: l.total &gt;= 0)"/>
                        <t t-set="deduction_lines" t-value="visible_lines.filtered(lambda l: l.total &lt; 0)"/>
                        <t t-set="deduction_total" t-value="abs(sum(deduction_lines.mapped('total')))"/>
                        <!-- Use Odoo's computed net_wage to avoid double-counting intermediate lines -->
                        <t t-set="net_salary"      t-value="o.net_wage"/>
                        <t t-set="revenue_total"   t-value="net_salary + deduction_total"/>

                        <!-- INCOME TABLE -->
                        <table style="width: 100%; border-collapse: collapse; font-size: 10pt; margin-bottom: 2mm;">
                            <thead>
                                <tr>
                                    <th style="text-align: left; padding: 3px 0; font-weight: bold; text-decoration: underline; width: 55%;">Description</th>
                                    <th style="text-align: right; padding: 3px 8px; font-weight: bold; text-decoration: underline; width: 20%;">Quantity</th>
                                    <th style="text-align: right; padding: 3px 0; font-weight: bold; text-decoration: underline; width: 25%;">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="income_lines" t-as="line">
                                    <tr>
                                        <td style="padding: 2px 0; text-transform: uppercase;">
                                            <span t-out="line.name"/>
                                        </td>
                                        <td style="text-align: right; padding: 2px 8px;">
                                            <t t-if="line.quantity != 0">
                                                <t t-set="qty_int" t-value="int(line.quantity)"/>
                                                <t t-if="line.quantity == qty_int">
                                                    <span t-out="qty_int"/>
                                                </t>
                                                <t t-else="">
                                                    <t t-set="qty_fmt" t-value="'{:.2f}'.format(line.quantity)"/>
                                                    <span t-out="qty_fmt"/>
                                                </t>
                                            </t>
                                        </td>
                                        <td style="text-align: right; padding: 2px 0;">
                                            <t t-if="line.total != 0">
                                                <t t-set="total_fmt" t-value="'{:,.0f}'.format(line.total).replace(',', '.')"/>
                                                <span t-out="total_fmt"/>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- INCOME SUBTOTAL -->
                        <div style="text-align: right; font-weight: bold; text-decoration: underline; font-size: 10pt; margin-bottom: 5mm;">
                            Subtotal:&#160;
                            <t t-set="rev_fmt" t-value="'{:,.0f}'.format(revenue_total).replace(',', '.')"/>
                            <span t-out="rev_fmt"/>
                        </div>

                        <!-- DEDUCTION TABLE -->
                        <table style="width: 100%; border-collapse: collapse; font-size: 10pt; margin-bottom: 2mm;">
                            <tbody>
                                <t t-foreach="deduction_lines" t-as="line">
                                    <tr>
                                        <td style="padding: 2px 0; text-transform: uppercase; width: 55%;">
                                            <span t-out="line.name"/>
                                        </td>
                                        <td style="text-align: right; padding: 2px 8px; width: 20%;">
                                            <t t-if="line.quantity != 0">
                                                <t t-set="qty_int" t-value="int(line.quantity)"/>
                                                <t t-if="line.quantity == qty_int">
                                                    <span t-out="qty_int"/>
                                                </t>
                                                <t t-else="">
                                                    <t t-set="qty_fmt" t-value="'{:.2f}'.format(line.quantity)"/>
                                                    <span t-out="qty_fmt"/>
                                                </t>
                                            </t>
                                        </td>
                                        <td style="text-align: right; padding: 2px 0; width: 25%;">
                                            <t t-set="total_fmt" t-value="'{:,.0f}'.format(line.total).replace(',', '.')"/>
                                            <span t-out="total_fmt"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- DEDUCTION SUBTOTAL -->
                        <div style="text-align: right; font-weight: bold; text-decoration: underline; font-size: 10pt; margin-bottom: 5mm;">
                            Subtotal:&#160;
                            <t t-set="ded_fmt" t-value="'{:,.0f}'.format(deduction_total).replace(',', '.')"/>
                            <span t-out="ded_fmt"/>
                        </div>

                        <!-- NET TOTAL BOX -->
                        <div style="border: 2px solid #000000; padding: 3mm 5mm; text-align: right; font-weight: bold; font-size: 12pt; margin-bottom: 12mm; text-transform: uppercase;">
                            Total:&#160;
                            <t t-set="net_fmt" t-value="'{:,.0f}'.format(net_salary).replace(',', '.')"/>
                            <span t-out="net_fmt"/>
                        </div>

                        <!-- SIGNATURE -->
                        <div style="font-size: 10pt; margin-top: 8mm;">
                            <strong>Signature</strong>
                            <br/><br/><br/><br/>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_nd_payslip" model="ir.actions.report">
        <field name="name">Undeclared Payment Ticket</field>
        <field name="model">hr.payslip</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tanatech_hr_payroll.report_nd_payslip</field>
        <field name="report_file">tanatech_hr_payroll.report_nd_payslip</field>
        <field name="print_report_name">'Undeclared Payment - %s' % (object.employee_id.name)</field>
        <field name="attachment"></field>
        <field name="attachment_use" eval="False"/>
    </record>

</odoo>
