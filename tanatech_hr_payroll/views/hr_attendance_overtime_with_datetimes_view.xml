<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_attendance_overtime_with_datetimes_view_form" model="ir.ui.view">
        <field name="name">hr.attendance.overtime.with.datetimes.form</field>
        <field name="model">hr.attendance.overtime.with.datetimes</field>
        <field name="arch" type="xml">
            <form string="Employee overtime" duplicate="false" create="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id" widget="many2one_avatar_user" readonly="1"/>
                            <field name="company_id" readonly="1" />
                            <field name="attendance_id" readonly="1" />
                        </group>
                        <group>
                            <field name="overtime_type" readonly="1" invisible="1" />
                            <field name="overtime_type_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}"/>
                            <field name="date" readonly="1" />
                            <field name="start_date" readonly="1" />
                            <field name="end_date" readonly="1" />
                            <field name="duration" widget="float_time" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_attendance_overtime_with_datetimes_tree" model="ir.ui.view">
        <field name="name">hr.attendance.overtime.with.datetimes.list</field>
        <field name="model">hr.attendance.overtime.with.datetimes</field>
        <field name="arch" type="xml">
            <list edit="0" create="0">
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="employee_id"/>
                <field name="overtime_type" column_invisible="1" />
                <field name="overtime_type_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}"/>
                <field name="duration" widget="float_time" sum="Total Overtimes"/>
            </list>
        </field>
    </record>

    <record id="view_attendance_overtime_with_datetimes_search" model="ir.ui.view">
        <field name="name">hr.attendance.overtime.with.datetimes.search</field>
        <field name="model">hr.attendance.overtime.with.datetimes</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="duration" filter_domain="[('duration', '>=', self)]"/>
                <group expand="0" string="Group By">
                    <filter string="Date" name="groupby_date" context="{'group_by': 'date:week'}"/>
                    <filter string="Employee" name="employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Type" name="overtime_type" context="{'group_by': 'overtime_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="hr_attendance_overtime_with_datetimes_action" model="ir.actions.act_window">
        <field name="name">Extra Hours</field>
        <field name="res_model">hr.attendance.overtime.with.datetimes</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                No overtime with datetimes records found
            </p><p>
                The overtime with datetimes records of your employees will be displayed here.
            </p>
        </field>
    </record>

    <!-- <menuitem 
        id="menu_hr_attendance_ovetime_with_datetimes_view" 
        name="Overtime With Datetimes" 
        parent="hr_attendance.menu_hr_attendance_root" 
        sequence="15" 
        action="hr_attendance_overtime_with_datetimes_action"
    /> -->

    <menuitem 
        id="menu_hr_attendance_ovetime_with_datetimes_view" 
        name="Overtime With Datetimes" 
        parent="tanatech_hr_payroll.main_menu_hr_attendance_ovetime_view" 
        sequence="1" 
        action="hr_attendance_overtime_with_datetimes_action"
    />

</odoo>
