<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Éligibilité à la prime de mission (règle D).

       La vue s'accroche au groupe « allowance_info » posé par
       tanatech_hr_contract : c'est déjà l'encart des accessoires de paie du
       contrat (allocation familiale), la case y est à sa place. L'héritage vise
       la vue de tanatech_hr_contract et non celle d'origine, pour être certain
       que le groupe existe au moment de l'application. -->
  <record id="hr_contract_view_form_mission" model="ir.ui.view">
    <field name="name">hr.contract.form.mission.eligible</field>
    <field name="model">hr.contract</field>
    <field name="inherit_id" ref="tanatech_hr_contract.hr_contract_view_form_extent"/>
    <field name="arch" type="xml">

      <xpath expr="//group[@name='allowance_info']" position="inside">
        <group name="mission">
          <field name="tanatech_mission_eligible"/>
        </group>
      </xpath>

    </field>
  </record>

</odoo>
