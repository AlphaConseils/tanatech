<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="overtime_resource_calendar_form" model="ir.ui.view">
        <field name="name">hr.attendance.overtime.resource.calendar.form</field>
        <field name="model">hr.attendance.overtime.resource.calendar</field>
        <field name="arch" type="xml">
            <form string="Extra Hours Time">
                <sheet string="Extra Hours Time">
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group name="time_resource_details" col="2">
                        <field name="company_id"/>
                    </group>
                    <notebook>
                        <page string="Scheduled Overtime Hours" name="overtime_hours">
                            <field name="time_ids" widget="section_one2many"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_overtime_resource_calendar_tree" model="ir.ui.view">
        <field name="name">hr.attendance.overtime.resource.calendar.list</field>
        <field name="model">hr.attendance.overtime.resource.calendar</field>
        <field name="arch" type="xml">
            <list string="Overtime Schedule">
                <field name="name" string="Overtime Schedule"/>
                <field name="company_id" />
            </list>
        </field>
    </record>

    <record id="action_overtime_resource_calendar_form" model="ir.actions.act_window">
        <field name="name">Overtime Schedules</field>
        <field name="res_model">hr.attendance.overtime.resource.calendar</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" eval="False"/>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Define overtime hours cagetories that could be scheduled to your overtimes
          </p>
        </field>
    </record>

    <menuitem 
        id="menu_hr_attendance_ovetime_resource_calendar_view" 
        name="Overtime Resource Calendar" 
        parent="tanatech_hr_payroll.main_menu_hr_attendance_ovetime_view" 
        sequence="2" 
        action="action_overtime_resource_calendar_form"
    />

</odoo>
